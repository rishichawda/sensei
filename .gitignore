node_modules/

# Planning artifacts — never committed (design spec, implementation plan,
# status notes, superpowers plans). Portable so you have them in the new
# location, not meant for git history.
docs/

# Machine-local Claude Code state (settings, installed skills, worktrees) — never shared.
.claude/

# Written by the engine for the mod (it extends the gitignored .claude-plugin/types/tsconfig.json).
/tsconfig.json

# Runtime output from the teach skill's diagram publishing (mermaid-maker/
# svg-maker write here at whatever cwd they're run from) — never committed.
viz/

# claude plugin eval run output (local only)
evals/results/
